# 둘이서 서버 환경변수 목록. 값은 넣지 않는다.
# 맥에서 실행할 때: 이 파일을 .env로 복사해 값을 채운다 (.env는 커밋되지 않는다).
# 공개 설정값은 claude.ai 프로젝트 문서 config/environment.md에 있다. 비밀값은 사용자 맥에만 있다.

SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/duriseo
DB_USERNAME=duriseo
DB_PASSWORD=

# Google 로그인: 웹 애플리케이션 클라이언트 ID (공개 설정값)
GOOGLE_WEB_CLIENT_ID=

# 카카오: 앱 ID (공개 설정값), 어드민 키 (비밀값)
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=

# Firebase: 프로젝트 ID (공개 설정값), 서비스 계정 키 JSON을 base64로 인코딩한 값 (비밀값)
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_BASE64=

# 프로필 사진 저장소 (API.md 8장). 맥·개발 서버는 local(폴더), 운영은 s3(버킷 이름은 공개 설정값).
# 운영 버킷은 prod 앱만 쓴다: 맥·dev에서 STORAGE_TYPE=s3로 운영 버킷을 가리키지 않는다 (정리 작업이 운영 사진을 지울 수 있다).
# S3 자격 증명은 env에 넣지 않는다: AWS 서버의 EC2 역할이 준다 (키 없음).
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/profile-images
STORAGE_S3_BUCKET=
# s3일 때만 의미가 있다. prod 앱만 true (deploy.sh가 넣는다). 기본 false
STORAGE_CLEANUP_ENABLED=false

# 토큰 서명 키 (비밀값). 32바이트 이상, 문자열 그대로(UTF-8) 키로 쓴다. 비어 있으면 서버가 시작하지 않는다.
# 맥에서는 openssl rand -hex 32 로 만든다 (64자)
JWT_SECRET=
